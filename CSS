<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - ข้อมูลติดต่อ</title>
    
    <style>
        /* 1. จัดการพื้นหลังและใช้ Flexbox จัดกึ่งกลางหน้าจอ */
        body {
            background-color: #E8F0FE; /* สีพื้นหลังเว็บ (เปลี่ยนสีได้) */
            font-family: 'Sarabun', Tahoma, sans-serif; /* ฟอนต์ */
            
            /* คำสั่ง Flexbox ที่ครูแนะนำ */
            display: flex; 
            justify-content: center; /* จัดให้อยู่กึ่งกลางแนวนอน */
            align-items: center; /* จัดให้อยู่กึ่งกลางแนวตั้ง */
            height: 100vh; /* ให้ความสูงเต็มหน้าจอพอดี */
            margin: 0;
        }

        /* 2. ตกแต่ง "กล่อง" ที่ใส่ข้อมูลของเรา */
        .contact-card {
            background-color: #FFFFFF; /* สีพื้นหลังกล่องเป็นสีขาว */
            padding: 40px; /* ระยะห่างขอบด้านใน */
            border-radius: 20px; /* ทำให้มุมกล่องโค้งมน */
            box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1); /* ใส่เงาให้กล่องดูลอยขึ้นมา */
            text-align: center; /* ให้ตัวหนังสือตรงกลางจัดกึ่งกลาง */
            width: 350px; /* ความกว้างของกล่อง */
        }

        /* 3. ตกแต่ง "รูปโปรไฟล์" ให้เป็นวงกลมตามโจทย์ */
        .profile-pic {
            width: 150px; 
            height: 150px;
            border-radius: 50%; /* คำสั่งนี้ทำให้รูปกลายเป็นวงกลม */
            object-fit: cover; /* ป้องกันรูปเบี้ยว */
            border: 4px solid #4285F4; /* ใส่เส้นขอบให้รูปโปรไฟล์ (เปลี่ยนสีได้) */
            margin-bottom: 20px;
        }

        /* 4. ตกแต่ง "ข้อความ" ข้อมูลส่วนตัว */
        .info-box {
            text-align: left; /* ให้ข้อมูลจัดชิดซ้ายจะได้อ่านง่าย */
            font-size: 16px;
            line-height: 1.8; /* ระยะห่างระหว่างบรรทัด */
            color: #333;
        }
        
        /* ตกแต่งหัวข้อ */
        h2 {
            color: #1A73E8;
            margin-top: 0;
        }
    </style>
</head>
<body>

    <!-- กล่องหลักที่จะถูก Flexbox จัดให้อยู่ตรงกลาง -->
    <div class="contact-card">
        
        <h2>ข้อมูลติดต่อ</h2>

        <!-- รูปโปรไฟล์ (อย่าลืมเอารูปตัวเองที่ชื่อ profile.png มาไว้ในโฟลเดอร์เดียวกัน) -->
        <img src="profile.png" alt="Profile" class="profile-pic">

        <!-- ข้อมูลส่วนตัว -->
        <div class="info-box">
            <b>ชื่อ-นามสกุล:</b> นาย/นางสาว [ใส่ชื่อ นามสกุล]<br>
            <b>ชื่อเล่น:</b> [ใส่ชื่อเล่น]<br>
            <b>ระดับชั้น:</b> ม.4/10 <b>เลขที่:</b> [XX]<br>
            <b>วันเกิด:</b> [วว/ดด/ปป] <b>อายุ:</b> [XX] ปี<br>
            <b>อีเมล:</b> [ใส่อีเมล]<br>
            <b>Line ID:</b> [ใส่ไอดีไลน์]<br>
            <b>เบอร์โทรศัพท์:</b> [ใส่เบอร์โทร]
        </div>

    </div>

</body>
</html>